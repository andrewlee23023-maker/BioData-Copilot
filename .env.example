# Optional: enables Gemini planning + explanations. Without it, the deterministic fallback is used.
GEMINI_API_KEY=

# Gemini model used for planning and explanations (single place to configure it)
GEMINI_MODEL=gemini-3.5-flash-lite

# Allowed CORS origin(s) for the frontend; comma-separate several
FRONTEND_ORIGIN=http://localhost:5173

# In-memory session limits
MAX_SESSIONS=50
SESSION_TTL_SECONDS=3600
